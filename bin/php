#!/usr/bin/env bash
if docker ps --format '{{.Names}}' | grep -q "^sipela-app$"; then
    docker exec -i -u 1000:1000 sipela-app php "$@"
else
    docker run --rm -i --net=host -u 1000:1000 -v "$(pwd)/.composer:/composer" -e COMPOSER_HOME=/composer -v "$(pwd):/var/www/html" -w /var/www/html sipela-app:latest php "$@"
fi
